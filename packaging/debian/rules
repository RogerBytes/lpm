#!/usr/bin/make -f

%:
	dh $@

# lib/*.sh ne sont pas exécutables dans le dépôt (chmod fait par install.sh à l'installation
# manuelle) -- dh_install copie en préservant les permissions source, donc on corrige ici
# avant que dh_fixperms ne fige les droits finaux du paquet.
override_dh_install:
	dh_install
	chmod +x debian/ludis/usr/lib/ludis/*.sh
	chmod +x debian/ludis/usr/bin/ludis
	# Interface graphique GTK4/Libadwaita (gui/) + son lanceur (bin/ludis-gui) : même correctif
	# de permissions que ci-dessus, et seulement si le paquet source les contient (voir
	# ludis.install) -- "|| true" pour ne jamais faire échouer le build si absents.
	chmod +x debian/ludis/usr/lib/ludis/gui/*.py 2>/dev/null || true
	chmod +x debian/ludis/usr/bin/ludis-gui
	# La complétion bash doit s'appeler exactement "ludis" (nom de la commande) : le format
	# debian/*.install ne sait pas renommer un fichier, seulement choisir son dossier de
	# destination -- on le copie donc ici, à la main, sous le bon nom.
	install -Dm644 completions/ludis.bash debian/ludis/usr/share/bash-completion/completions/ludis

# Rien à tester (pas de suite de tests) : no-op explicite plutôt que de laisser dh deviner.
override_dh_auto_test:
