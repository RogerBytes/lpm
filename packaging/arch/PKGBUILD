# Maintainer: Harry <harry.richmond@rogerbytes.com>
pkgname=ludis
pkgver=0.9.3
pkgrel=1
pkgdesc="Prefix manager for Lutris (Wine/Proton games and runners)"
arch=('any')
url="https://rogerbytes.com"
license=('MIT' 'GPL3')  # MIT: ludis code -- GPL3: assets/icons/application-x-zg{p,r}-*.svg
                        # (traced artwork from Mint-L-Blue, see packaging/debian/copyright)
depends=('bash' 'python' 'python-yaml' 'python-gobject' 'python-evdev' 'sdl2' 'sqlite' 'zstd' 'pv' 'libarchive'
         'desktop-file-utils' 'shared-mime-info' 'hicolor-icon-theme' 'gtk4>=4.10' 'libadwaita>=1.5')
optdepends=('lutris: manage Lutris games'
            'wine: run Windows games'
            'winetricks: Windows dependencies inside wineprefixes'
            'imagemagick: SteamGridDB icon processing'
            'xdotool: automatic window focus, gamepad bridge under X11'
            'ydotool: gamepad bridge under Wayland'
            'curl: download remote runners'
            'bash-completion: bash completion for ludis')
replaces=('lpm')
conflicts=('lpm')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 bin/ludis "$pkgdir/usr/bin/ludis"

  # Interface graphique GTK4/Libadwaita (gui/) + son lanceur (bin/ludis-gui) : gtk4 et
  # libadwaita sont des dépendances obligatoires (voir depends= ci-dessus), donc bin/ludis
  # et bin/ludis-gui n'ont plus besoin de vérifier leur présence à l'exécution.
  install -Dm755 bin/ludis-gui "$pkgdir/usr/bin/ludis-gui"
  install -d "$pkgdir/usr/lib/ludis/gui"
  for f in gui/*.py; do
    install -Dm755 "$f" "$pkgdir/usr/lib/ludis/gui/$(basename "$f")"
  done

  install -d "$pkgdir/usr/lib/ludis"
  for f in lib/*.sh; do
    install -Dm755 "$f" "$pkgdir/usr/lib/ludis/$(basename "$f")"
  done
  for f in lib/*.py; do
    install -Dm755 "$f" "$pkgdir/usr/lib/ludis/$(basename "$f")"
  done

  install -d "$pkgdir/usr/lib/ludis/data"
  for f in lib/data/*; do
    install -Dm644 "$f" "$pkgdir/usr/lib/ludis/data/$(basename "$f")"
  done

  install -d "$pkgdir/usr/lib/ludis/lang"
  for f in lang/*.lang; do
    install -Dm644 "$f" "$pkgdir/usr/lib/ludis/lang/$(basename "$f")"
  done

  install -Dm644 completions/ludis.bash "$pkgdir/usr/share/bash-completion/completions/ludis"
  install -Dm644 completions/_ludis "$pkgdir/usr/share/zsh/site-functions/_ludis"
  install -Dm644 man/man1/ludis.1 "$pkgdir/usr/share/man/man1/ludis.1"
  install -Dm644 man/fr/man1/ludis.1 "$pkgdir/usr/share/man/fr/man1/ludis.1"

  install -Dm644 assets/icons/ludis.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/ludis.svg"
  install -Dm644 assets/icons/ludis-game-generic.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/ludis-game-generic.svg"
  install -Dm644 assets/icons/application-x-zgp-game.svg "$pkgdir/usr/share/icons/hicolor/scalable/mimetypes/application-x-zgp-game.svg"
  install -Dm644 assets/icons/application-x-zgr-runner.svg "$pkgdir/usr/share/icons/hicolor/scalable/mimetypes/application-x-zgr-runner.svg"

  install -Dm644 packaging/common/ludis.desktop "$pkgdir/usr/share/applications/ludis.desktop"
  install -Dm644 packaging/common/ludis.xml "$pkgdir/usr/share/mime/packages/ludis.xml"

  # Compatibility with the former name "lpm": existing shortcuts point to /usr/lib/lpm.
  ln -s ludis "$pkgdir/usr/lib/lpm"
  ln -s ludis "$pkgdir/usr/bin/lpm"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
