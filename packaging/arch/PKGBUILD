# Maintainer: Harry <harry.richmond@rogerbytes.com>
pkgname=lpm
pkgver=0.9.2
pkgrel=1
pkgdesc="Package manager for Lutris (Wine/Proton games and runners)"
arch=('any')
url="https://rogerbytes.com"
license=('MIT' 'GPL3')  # MIT: lpm code -- GPL3: assets/icons/application-x-zg{p,r}-*.svg
                        # (traced artwork from Mint-L-Blue, see packaging/debian/copyright)
depends=('bash' 'python' 'python-yaml' 'python-gobject' 'python-evdev' 'sdl2' 'sqlite' 'zenity' 'zstd' 'libarchive'
         'desktop-file-utils' 'shared-mime-info' 'hicolor-icon-theme')
optdepends=('lutris: manage Lutris games'
            'wine: run Windows games'
            'winetricks: Windows dependencies inside wineprefixes'
            'imagemagick: SteamGridDB icon processing'
            'xdotool: automatic window focus, gamepad bridge under X11'
            'ydotool: gamepad bridge under Wayland'
            'curl: download remote runners'
            'bash-completion: bash completion for lpm')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm755 bin/lpm "$pkgdir/usr/bin/lpm"

  install -d "$pkgdir/usr/lib/lpm"
  for f in lib/*.sh; do
    install -Dm755 "$f" "$pkgdir/usr/lib/lpm/$(basename "$f")"
  done
  for f in lib/*.py; do
    install -Dm755 "$f" "$pkgdir/usr/lib/lpm/$(basename "$f")"
  done

  install -d "$pkgdir/usr/lib/lpm/data"
  for f in lib/data/*; do
    install -Dm644 "$f" "$pkgdir/usr/lib/lpm/data/$(basename "$f")"
  done

  install -d "$pkgdir/usr/lib/lpm/lang"
  for f in lang/*.lang; do
    install -Dm644 "$f" "$pkgdir/usr/lib/lpm/lang/$(basename "$f")"
  done

  install -Dm644 completions/lpm.bash "$pkgdir/usr/share/bash-completion/completions/lpm"
  install -Dm644 completions/_lpm "$pkgdir/usr/share/zsh/site-functions/_lpm"
  install -Dm644 man/man1/lpm.1 "$pkgdir/usr/share/man/man1/lpm.1"
  install -Dm644 man/fr/man1/lpm.1 "$pkgdir/usr/share/man/fr/man1/lpm.1"

  install -Dm644 assets/icons/lpm.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/lpm.svg"
  install -Dm644 assets/icons/lpm-game-generic.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/lpm-game-generic.svg"
  install -Dm644 assets/icons/application-x-zgp-game.svg "$pkgdir/usr/share/icons/hicolor/scalable/mimetypes/application-x-zgp-game.svg"
  install -Dm644 assets/icons/application-x-zgr-runner.svg "$pkgdir/usr/share/icons/hicolor/scalable/mimetypes/application-x-zgr-runner.svg"

  install -Dm644 packaging/common/lpm.desktop "$pkgdir/usr/share/applications/lpm.desktop"
  install -Dm644 packaging/common/lpm.xml "$pkgdir/usr/share/mime/packages/lpm.xml"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
