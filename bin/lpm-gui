#!/bin/bash
# --- Launcher for lpm's GTK4/Libadwaita graphical interface ---
#
# The GUI implements no business logic: it calls the same lib/ scripts in CLI mode,
# exactly as a terminal would.
set -euo pipefail

# Same dev vs system detection as bin/lpm (see that file).
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
case "${script_dir}" in
  /usr/local/bin) gui_dir="/usr/local/lib/lpm/gui"; lib_dir="/usr/local/lib/lpm" ;;
  /usr/bin)       gui_dir="/usr/lib/lpm/gui";       lib_dir="/usr/lib/lpm" ;;
  *)              gui_dir="$(dirname "${script_dir}")/gui"; lib_dir="$(dirname "${script_dir}")/lib" ;;
esac

# Language loader is sourced before the error messages below so they go through t()
# like the rest of the CLI. If lib_dir or the loader itself is missing, fall back to
# the hard-coded French message below (it cannot be localized; same reason as bin/lpm).
if [[ -f "${lib_dir}/zgl-lang-loader.sh" ]]; then
  # shellcheck source=../lib/zgl-lang-loader.sh
  source "${lib_dir}/zgl-lang-loader.sh"
fi

if [[ ! -f "${gui_dir}/lpm_gtk.py" ]]; then
  if declare -F t >/dev/null 2>&1; then
    echo "$(t launcher.gui_not_found "${gui_dir}")" >&2
  else
    echo "Critical error: the GUI was not found at: ${gui_dir}" >&2
  fi
  exit 1
fi

if ! command -v python3 >/dev/null 2>&1; then
  if declare -F t >/dev/null 2>&1; then
    echo "$(t launcher.python3_missing)" >&2
  else
    echo "Erreur : python3 est requis pour l'interface graphique." >&2
  fi
  exit 1
fi

# PyGObject + GTK4 (>= 4.10) + Libadwaita (>= 1.5) are a hard dependency of the lpm
# package since 0.9.3 (see packaging/), so they are not checked here. If lpm_gtk.py
# crashes on importing gi/Gtk/Adw, the installation itself is broken.
exec python3 "${gui_dir}/lpm_gtk.py" "$@"
