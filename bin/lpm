#!/bin/bash

# --- 0. Version ---
readonly LPM_VERSION="v0.9.4"

# --- 1. Locate the libs (dev vs system install) ---
# Two possible system install locations depending on how the binary was installed
# (manual install.sh vs .deb/.rpm/Arch package, see packaging/); anything else is
# assumed to be dev mode (run straight from the repo).
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

case "${SCRIPT_DIR}" in
    /usr/local/bin) LIB_DIR="/usr/local/lib/lpm" ;;  # install.sh (manual install)
    /usr/bin)       LIB_DIR="/usr/lib/lpm" ;;        # .deb/.rpm/Arch package
    *)              LIB_DIR="${SCRIPT_DIR}/../lib" ;; # dev mode
esac

if [[ ! -d "${LIB_DIR}" ]]; then
    # Deliberately not localized: the language loader lives in lib/ itself, so it
    # cannot be loaded when that folder is missing. A message on stderr is enough
    # (lpm cannot start without lib/, so lpm-gui cannot either).
    echo "Critical error: the libraries folder (lib) was not found at: ${LIB_DIR}"
    exit 1
fi

# shellcheck source=./lib/zgl-lang-loader.sh
source "${LIB_DIR}/zgl-lang-loader.sh"

# --- 1bis. Version display (--version / -v) ---
if [[ "$1" = "--version" ]] || [[ "$1" = "-v" ]]; then
    echo "lpm ${LPM_VERSION}"
    exit 0
fi

# --- 1ter. Help display (--help / -h) ---
print_help() {
    t help.title
    echo ""
    t help.usage_header
    printf "  %-38s %s\n" "lpm" "$(t help.usage_menu)"
    printf "  %-38s %s\n" "lpm-gui [file.zgp|.zgr]" "$(t help.usage_direct)"
    echo ""
    t help.games_header
    printf "  %-42s %s\n" "lpm install [-y] <files.zgp...>" "$(t help.games_install)"
    printf "  %-42s %s\n" "lpm uninstall [-y] <slugs...>" "$(t help.games_uninstall)"
    printf "  %-42s %s\n" "lpm pack [-LEVEL] [--hash] <slugs...|--all>" "$(t help.games_pack)"
    printf "  %-42s %s\n" "lpm isolate [-y] <store|slug>" "$(t help.games_isolate)"
    printf "  %-42s %s\n" "lpm list" "$(t help.games_list)"
    printf "  %-42s %s\n" "lpm list-isolable" "$(t help.games_list_isolable)"
    printf "  %-42s %s\n" "lpm info <slug>" "$(t help.games_info)"
    printf "  %-42s %s\n" "lpm create-prefix [-y] <names...>" "$(t help.games_create_prefix)"
    printf "  %-42s %s\n" "" "$(t help.games_create_prefix_cont)"
    printf "  %-42s %s\n" "lpm exe-install [-y] <file[|name[|slug]]>" "$(t help.games_exe_install)"
    printf "  %-42s %s\n" "" "$(t help.games_exe_install_cont)"
    printf "  %-42s %s\n" "lpm shortcut <slugs...|--all>" "$(t help.games_shortcut)"
    printf "  %-42s %s\n" "" "$(t help.games_shortcut_cont)"
    printf "  %-42s %s\n" "lpm icon <slugs...|--all>" "$(t help.games_icon)"
    printf "  %-42s %s\n" "lpm splash <slugs...|--all>" "$(t help.games_splash)"
    printf "  %-42s %s\n" "lpm logo <slugs...|--all>" "$(t help.games_logo)"
    printf "  %-42s %s\n" "lpm sync-media <slugs...|--all>" "$(t help.games_sync_media)"
    printf "  %-42s %s\n" "lpm tools <slug> <tool> [args]" "$(t help.games_tools)"
    printf "  %-42s %s\n" "" "$(t help.games_tools_cont)"
    printf "  %-42s %s\n" "lpm vsync status | <slug> on|off [setting...]" "$(t help.games_vsync)"
    printf "  %-42s %s\n" "" "$(t help.games_vsync_cont)"
    printf "  %-42s %s\n" "lpm lsfg <slugs...> on|off" "$(t help.games_lsfg)"
    printf "  %-42s %s\n" "" "$(t help.games_lsfg_cont)"
    printf "  %-42s %s\n" "lpm launcher <slugs...> on|off" "$(t help.games_launcher)"
    printf "  %-42s %s\n" "" "$(t help.games_launcher_cont)"
    printf "  %-42s %s\n" "lpm launcher-entries <slug> get" "$(t help.games_launcher_entries_get)"
    printf "  %-42s %s\n" "lpm launcher-entries <slug> set <file.json>" "$(t help.games_launcher_entries_set)"
    printf "  %-42s %s\n" "lpm killwine [-y]" "$(t help.games_killwine)"
    echo ""
    t help.runners_header
    printf "  %-52s %s\n" "lpm install-runner [-y] <files.zgr|names...>" "$(t help.runners_install)"
    printf "  %-52s %s\n" "" "$(t help.runners_install_cont)"
    printf "  %-52s %s\n" "lpm uninstall-runner [-y] <names...>" "$(t help.runners_uninstall)"
    printf "  %-52s %s\n" "lpm pack-runner [-LEVEL] [--hash] <names...|--all>" "$(t help.runners_pack)"
    printf "  %-52s %s\n" "lpm list-runner" "$(t help.runners_list)"
    printf "  %-52s %s\n" "lpm list-remote-runners" "$(t help.runners_list_remote)"
    printf "  %-52s %s\n" "" "$(t help.runners_list_remote_cont)"
    echo ""
    t help.deps_header
    printf "  %-36s %s\n" "lpm check" "$(t help.deps_check)"
    printf "  %-36s %s\n" "" "$(t help.deps_check_cont1)"
    printf "  %-36s %s\n" "" "$(t help.deps_check_cont2)"
    printf "  %-36s %s\n" "lpm lutris-version [flatpak|native|reset]" "$(t help.lutris_version)"
    printf "  %-36s %s\n" "lpm self-update [check|install]" "$(t help.self_update)"
    echo ""
    t help.log_header
    printf "  %-36s %s\n" "lpm log [-n N]" "$(t help.log_show)"
    printf "  %-36s %s\n" "lpm log --all" "$(t help.log_all)"
    printf "  %-36s %s\n" "lpm log --grep <pattern>" "$(t help.log_grep)"
    printf "  %-36s %s\n" "lpm log --clear" "$(t help.log_clear)"
    echo ""
    t help.options_header
    printf "  %-36s %s\n" "-y" "$(t help.opt_y)"
    printf "  %-36s %s\n" "--allow-scripts" "$(t help.opt_allow_scripts)"
    printf "  %-36s %s\n" "--ignore-hash" "$(t help.opt_ignore_hash)"
    printf "  %-36s %s\n" "--hash" "$(t help.opt_hash)"
    printf "  %-36s %s\n" "-LEVEL (0-22)" "$(t help.opt_level)"
    printf "  %-36s %s\n" "--version, -v" "$(t help.opt_version)"
    printf "  %-36s %s\n" "--help, -h" "$(t help.opt_help)"
    echo ""
    t help.footer
}

if [[ "$1" = "--help" ]] || [[ "$1" = "-h" ]]; then
    # Prefer the installed man page (see install.sh) when available: it is more complete.
    # Fall back to the built-in text above when running from sources or on a system
    # without "man" -- --help must always work.
    if command -v man >/dev/null 2>&1 && man -w lpm >/dev/null 2>&1; then
        exec man lpm
    fi
    print_help
    exit 0
fi

# --- 3. CLI command routing ---
if [[ $# -gt 0 ]]; then
    command="$1"
    shift

    confirm_flag=""
    compression_level=""
    allow_scripts_flag=""
    ignore_hash_flag=""
    generate_hash_flag=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -y)
                confirm_flag="yes"
                shift
                ;;
            --allow-scripts)
                allow_scripts_flag="yes"
                shift
                ;;
            --ignore-hash)
                ignore_hash_flag="yes"
                shift
                ;;
            --hash)
                generate_hash_flag="yes"
                shift
                ;;
            -[0-9]|-1[0-9]|-2[0-2])
                compression_level="${1#-}"
                shift
                ;;
            *)
                break
                ;;
        esac
    done

    case "${command}" in
        install)
            exec bash "${LIB_DIR}/zgp-game-installer.sh" "cli" "${confirm_flag}" "${allow_scripts_flag}" "${ignore_hash_flag}" "$@"
            ;;
        install-runner)
            exec bash "${LIB_DIR}/zgr-runner-installer.sh" "cli" "${confirm_flag}" "${ignore_hash_flag}" "$@"
            ;;
        uninstall)
            exec bash "${LIB_DIR}/zgp-game-uninstaller.sh" "${confirm_flag}" "$@"
            ;;
        uninstall-runner)
            exec bash "${LIB_DIR}/zgr-runner-uninstaller.sh" "${confirm_flag}" "$@"
            ;;
        pack)
            exec bash "${LIB_DIR}/zgp-game-packer.sh" "${compression_level}" "${generate_hash_flag}" "$@"
            ;;
        isolate)
            exec bash "${LIB_DIR}/zgp-game-isolator.sh" "${confirm_flag}" "$@"
            ;;
        pack-runner)
            exec bash "${LIB_DIR}/zgr-runner-packer.sh" "${compression_level}" "${generate_hash_flag}" "$@"
            ;;
        create-prefix)
            exec bash "${LIB_DIR}/zgp-prefix-creator.sh" "cli" "${confirm_flag}" "$@"
            ;;
        exe-install)
            exec bash "${LIB_DIR}/zgp-exe-installer.sh" "cli" "${confirm_flag}" "$@"
            ;;
        shortcut)
            exec bash "${LIB_DIR}/zgp-game-shortcutter.sh" "$@"
            ;;
        icon)
            exec bash "${LIB_DIR}/zgp-game-icon.sh" "$@"
            ;;
        splash)
            exec bash "${LIB_DIR}/zgp-game-splash.sh" "$@"
            ;;
        logo)
            exec bash "${LIB_DIR}/zgp-game-logo.sh" "$@"
            ;;
        sync-media)
            exec bash "${LIB_DIR}/zgp-game-sync-media.sh" "$@"
            ;;
        tools)
            exec bash "${LIB_DIR}/zgp-game-tools.sh" "$@"
            ;;
        vsync)
            exec bash "${LIB_DIR}/zgp-game-vsync.sh" "$@"
            ;;
        lsfg)
            exec bash "${LIB_DIR}/zgl-lsfg-manager.sh" "$@"
            ;;
        lsfg-dll)
            exec bash "${LIB_DIR}/zgl-lsfg-dll.sh" "$@"
            ;;
        sgdb-key)
            exec bash "${LIB_DIR}/zgl-sgdb-key.sh" "$@"
            ;;
        sgdb-images)
            exec bash "${LIB_DIR}/zgl-sgdb-images.sh" "$@"
            ;;
        launcher)
            exec bash "${LIB_DIR}/zgl-launcher-manager.sh" "$@"
            ;;
        launcher-entries)
            exec bash "${LIB_DIR}/zgl-launcher-entries.sh" "$@"
            ;;
        killwine)
            exec bash "${LIB_DIR}/zgc-wine-killer.sh" "cli" "${confirm_flag}"
            ;;
        check)
            exec bash "${LIB_DIR}/zgc-dependency-checker.sh" "cli" "${confirm_flag}"
            ;;
        lutris-version)
            exec bash "${LIB_DIR}/zgc-lutris-version-checker.sh" "cli" "$@"
            ;;
        self-update)
            exec bash "${LIB_DIR}/zgc-self-update.sh" "${LPM_VERSION}" "$@"
            ;;
        list)
            exec bash "${LIB_DIR}/zgp-game-lister.sh"
            ;;
        list-isolable)
            exec bash "${LIB_DIR}/zgp-isolable-lister.sh"
            ;;
        info)
            exec bash "${LIB_DIR}/zgp-game-info.sh" "$@"
            ;;
        log)
            exec bash "${LIB_DIR}/zgp-log-viewer.sh" "$@"
            ;;
        list-runner)
            exec bash "${LIB_DIR}/zgr-runner-lister.sh"
            ;;
        list-remote-runners)
            exec bash "${LIB_DIR}/zgr-runner-remote-lister.sh"
            ;;
        *)
            t common.unknown_command "${command}"
            t common.unknown_command_hint
            exit 1
            ;;
    esac
fi

# --- 4. No argument: show help ---
# "lpm" is a scriptable terminal command and never opens a window. The GUI is started
# with "lpm-gui" (or from the application menu / by double-clicking a .zgp/.zgr file,
# see the Exec= field of lpm.desktop).
print_help
exit 0
